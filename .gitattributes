# Deploy artifacts are consumed by bash and nginx on Linux; CRLF breaks both.
# (setup.sh with CRLF fails on line 10, nginx rejects the config outright.)
deploy/* text eol=lf
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf

# Everything else: let git decide per platform.
* text=auto
