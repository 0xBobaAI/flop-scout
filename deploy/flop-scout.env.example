# /etc/flop-scout.env — secrets for Flop Scout. chmod 600, owned by root.
#
#   sudo install -m 600 -o root -g root deploy/flop-scout.env.example /etc/flop-scout.env
#   sudo nano /etc/flop-scout.env

# Required
FLOP_API_KEY=flop_replace_me

# Needed by renew_key.py (hourly timer). 12-word sr25519 phrase of the app wallet.
WALLET_MNEMONIC=replace with twelve words

# Optional
# Network. The defaults are the devnet. When the testnet opens, set both and
# restart; the session history archives the devnet record and starts over.
# FLOP_BASE_URL=https://api.flop.network/v1
# FLOP_EXPLORER_URL=https://explorer.devnet.flop.network
#
# Probes: Scout's own priced test requests. Off until the testnet; caps are
# enforced in probes.py. See GET /api/probes for the published policy.
# PROBES_ENABLED=0
# PROBE_INTERVAL_S=3600
# PROBE_MAX_PER_DAY=48
# PROBE_MAX_COST_FLOP=5
# PROBE_DAILY_BUDGET_FLOP=100
#
# Session history sync interval (seconds)
# SESSION_SYNC_S=300
# SCOUT_URL=https://your-reader.example
# FREE_ANSWERS_PER_DAY=20
# USER_ANSWERS_PER_MIN=6
# DUPLICATE_WINDOW_S=600
# CORS_ORIGINS=https://flopscout.com,https://www.flopscout.com
# DATA_DIR=/opt/flop-scout/data
